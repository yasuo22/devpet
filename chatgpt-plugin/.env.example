# ===== DevPet ChatGPT Plugin 环境变量示例 =====
# 复制为 .env 并填写实际值（.env 已被 gitignore，不会提交）

# 服务端口（默认 8787）
PORT=8787

# 公网可访问地址（部署后必填，ChatGPT Actions 需要 HTTPS）
# 示例：https://devpet-plugin.example.com
PUBLIC_BASE_URL=

# 外部请求超时（毫秒，默认 8000）
TIMEOUT_MS=8000

# 外部数据缓存时长（毫秒，默认 60000，用于降低第三方 API 限流）
CACHE_TTL_MS=60000

# 本地持久化存储文件路径（默认 .devpet-store.json，可指向卷/数据库挂载）
STORE_FILE=.devpet-store.json

# 可选：自定义 manifest 的 logo / 联系方式（默认指向 DevPet）
LOGO_URL=
CONTACT_EMAIL=
LEGAL_URL=
